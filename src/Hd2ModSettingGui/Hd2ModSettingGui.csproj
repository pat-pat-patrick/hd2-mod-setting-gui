<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF on the .NET Framework 4.8 every Windows 10 (1903+) and 11 has:
       nothing for a player to install, an exe of a few hundred KB. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HD2 Mod Setting GUI</AssemblyName>
    <RootNamespace>Hd2ModSettingGui</RootNamespace>
    <Version>1.5.0</Version>
    <Product>HD2 Mod Setting GUI</Product>
    <Company>pat-pat-patrick</Company>
    <Copyright>MIT License</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- no paths of the build machine in the exe -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=src</PathMap>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
